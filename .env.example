# Copy to .env and fill in credentials for live mode.
# Never commit .env to version control.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Brokerage credentials (read ONLY inside execution/zerodha_executor.py)
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Safety & execution flags
DRY_RUN=true
USE_MOCK_LLM=true

# NSE MCP mode: fixture (offline replay), stdio (local MCP server), or nse_live (NSE India MCP)
NSE_MCP_MODE=fixture
NSE_CM_MARKET_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp
NSE_BHAVCOPY_MCP_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
