FROM python:3.12-slim

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY config.py schemas ./schemas/
COPY mcp_server ./mcp_server/
COPY mcp_client ./mcp_client/
COPY guardrails ./guardrails/
COPY observability ./observability/
COPY agents ./agents/
COPY services/__init__.py services/agent_service.py ./services/

# Security invariant: zero KITE_* variables exist in the read-only agent container
ENV DRY_RUN=true
EXPOSE 8001

CMD ["uv", "run", "uvicorn", "services.agent_service:app", "--host", "0.0.0.0", "--port", "8001"]
