FROM python:3.12-slim

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY config.py schemas ./schemas/
COPY execution ./execution/
COPY observability ./observability/
COPY services/__init__.py services/execution_service.py ./services/

ENV DRY_RUN=true
EXPOSE 8002

CMD ["uv", "run", "uvicorn", "services.execution_service:app", "--host", "0.0.0.0", "--port", "8002"]
